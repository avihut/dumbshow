{
  "name": "dumbshow",
  "private": true,
  "description": "The dumbshow workspace — @dumbshow/core, @dumbshow/vue, the private boxes reference pack, and the Vue harness app.",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter dumbshow-harness-vue dev",
    "build": "pnpm -r build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.10",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11"
  }
}
