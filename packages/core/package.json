{
  "name": "@dumbshow/core",
  "version": "0.3.0",
  "description": "The framework-free core of dumbshow: the language-pack contract, the timeline engine and headless player, the render core, the transcript projection, the editor's document model and drag mechanics, and the exporters.",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avihut/dumbshow.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/avihut/dumbshow#readme",
  "bugs": "https://github.com/avihut/dumbshow/issues",
  "keywords": [
    "animation",
    "diagram",
    "canvas",
    "timeline",
    "engine"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && rm dist/style.js && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "gifenc": "1.0.3"
  }
}
